		--attempts 4 --attempt-delay 2.0 \
		--contains "RUN ACTWRITE.PRG" \
		--contains "ACTWRITE OK"
	$(PYTHON) -c "from pathlib import Path; assert Path('$(ACTION_ACTWRITE_FS)/IMAGES/ACTION.DNP/OUT.TXT').read_bytes() == b'ACTION WRITE OK'"
	test "`readlink $(ACTION_ACTWRITE_FS)/IMAGES/ACTION.DNP/out.txt`" = OUT.TXT

vice-resident: $(RESIDENT_DEPS)
