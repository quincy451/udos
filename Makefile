vice-tool-abi-swap: $(RESIDENT_DEPS) $(VICE_LAUNCH_FS)
	sleep 2
	$(PYTHON) tools/vice_prg_probe.py --disk $(abspath $(RESIDENT_DISK)) \
		--vice-arg=-iecdevice8 --vice-arg=-device8 --vice-arg=1 --vice-arg=-fs8 --vice-arg=$(abspath $(BUILD_DIR)) \
		--vice-arg=-iecdevice9 --vice-arg=-fs9 --vice-arg=$(abspath $(VICE_LAUNCH_FS)) \
		--vice-arg=-fslongnames --feed-after "A:D64/>" --feed-step-settle 2.5 \
		--feed-step "MOUNT B: /IMAGES/WORK.DNP\r" \
		--feed-step "B:\r" \
		--feed-step "CD SRC\r" \
		--feed-step "SWAPTEST\r" \
		--timeout 120 --attempts 2 --attempt-delay 2.0 \
		--expected "B:DNP/SRC>" --contains "RUN SWAPTEST.PRG" --contains "ABI SWAP OK" \
		--check-byte 0xCFF6=0x02 --check-byte 0xCFF7=0x5A
	test ! -e $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/SWPDIR
	test ! -e $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/swpdir
	! grep -qi '^D SWPDIR$$' $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/UDOSDIR.TXT
	$(PYTHON) -c "from pathlib import Path; assert Path('$(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/swpsave.bin').read_bytes() == b'A\\x00B!'"
	grep -qi '^F SWPSAVE.BIN$$' $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/UDOSDIR.TXT
	$(PYTHON) -c "from pathlib import Path; assert Path('$(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/swptext.txt').read_bytes() == b'OK'"
	grep -qi '^F SWPTEXT.TXT$$' $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/UDOSDIR.TXT
	$(PYTHON) -c "from pathlib import Path; assert Path('$(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/swpalias.txt').read_bytes() == b'ZP OK'"
	grep -qi '^F SWPALIAS.TXT$$' $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/UDOSDIR.TXT
	$(PYTHON) -c "from pathlib import Path; assert Path('$(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/swpalrn.txt').read_bytes() == b'ZP OK'"
	test ! -e $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/swpalcp.txt
	grep -qi '^F SWPALRN.TXT$$' $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/UDOSDIR.TXT
	! grep -qi '^F SWPALCP.TXT$$' $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/src/UDOSDIR.TXT

