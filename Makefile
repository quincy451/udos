		--feed-step "B:\r" \
		--feed-step "CD SRC\r" \
		--feed-step "COPY HELLO.PRG /WORK/HELLO2.PRG\r" \
		--feed-step "ECHO COPY OK\r" \
		--expected "COPY OK" --settle 2.0 --connect-delay 10.0 --attempts $(SELFTEST_ATTEMPTS) --output $(SELFTEST_COPY_ACTUAL)
