		--expected "A:D64/>" --settle 1.0 --absent "AUTOEXEC OK"

$(VICE_LAUNCH_FS): force $(RETURN_TEST_PRG) $(CHAIN_TEST_PRG) $(CLOBBER_TEST_PRG) $(TOOL_SWAP_TEST_PRG)
	$(PYTHON) tools/prepare_selftest_fs.py --base $(VICE_FS_ROOT) --output $(VICE_LAUNCH_FS)
	rm -f $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/result.txt
	rm -f $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/SWPSAVE.BIN $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/swpsave.bin
	rm -f $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/SWPTEXT.TXT $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/swptext.txt
	rm -f $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/SWPALIAS.TXT $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/swpalias.txt
	rm -f $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/SWPALCP.TXT $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/swpalcp.txt
	rm -f $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/SWPALRN.TXT $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/swpalrn.txt
	grep -v 'RESULT.TXT\|RETTEST.PRG\|CHAINTEST.PRG\|CLOBBER.PRG\|SWAPTEST.PRG\|SWPSAVE.BIN\|SWPTEXT.TXT\|SWPALIAS.TXT\|SWPALCP.TXT\|SWPALRN.TXT' $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/UDOSDIR.TXT > $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/udosdir.base
	cp $(RETURN_TEST_PRG) $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/rettest.prg
	cp $(CHAIN_TEST_PRG) $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/chaintest.prg
	cp $(CLOBBER_TEST_PRG) $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/clobber.prg
	cp $(TOOL_SWAP_TEST_PRG) $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/swaptest.prg
	{ \
		printf 'F SWAPTEST.PRG\n'; \
		printf 'F CLOBBER.PRG\n'; \
		printf 'F CHAINTEST.PRG\n'; \
		printf 'F RETTEST.PRG\n'; \
		cat $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/udosdir.base; \
	} > $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/UDOSDIR.TXT
	cp $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/UDOSDIR.TXT $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/udosdir.txt
	$(PYTHON) -c "from pathlib import Path; from tools.run_action_probe_fs import sync_case_path_variants; root=Path('$(VICE_LAUNCH_FS)/IMAGES/WORK.DNP'); [sync_case_path_variants(root, root/'SRC'/name) for name in ('rettest.prg','chaintest.prg','clobber.prg','swaptest.prg','UDOSDIR.TXT')]"
	rm -f $(VICE_LAUNCH_FS)/IMAGES/WORK.DNP/SRC/udosdir.base

$(VICE_REU_SERVICE_FS): force $(REU_SERVICE_TEST_PRG)
	$(PYTHON) tools/prepare_selftest_fs.py --base $(VICE_FS_ROOT) --output $(VICE_REU_SERVICE_FS)
	grep -v 'REUTEST.PRG\|REU_STG.TXT' $(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/UDOSDIR.TXT > $(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/udosdir.base
	cp $(REU_SERVICE_TEST_PRG) $(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/reutest.prg
	$(PYTHON) -c "from pathlib import Path; Path('$(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/reu_stg.txt').write_bytes(bytes(65 + (i % 26) for i in range(600)))"
	{ \
		printf 'F REUTEST.PRG\n'; \
		printf 'F REU_STG.TXT\n'; \
		cat $(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/udosdir.base; \
	} > $(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/UDOSDIR.TXT
	cp $(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/UDOSDIR.TXT $(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/udosdir.txt
	$(PYTHON) -c "from pathlib import Path; from tools.run_action_probe_fs import sync_case_path_variants; root=Path('$(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP'); [sync_case_path_variants(root, root/'SRC'/name) for name in ('reutest.prg','reu_stg.txt','UDOSDIR.TXT')]"
	rm -f $(VICE_REU_SERVICE_FS)/IMAGES/WORK.DNP/SRC/udosdir.base

