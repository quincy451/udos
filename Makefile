		--command "ACTC MAIN:" \
		--active-fragment "ACTDBG MAIN" --active-key "E" \
		--next-active-fragment "ACTEDIT src/main.act" --next-active-key-code 3 --done-fragment "" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/PROJ3>" \
		--shell-timeout 300 --attempts 3 --attempt-delay 4.0 \
		--host-exists "IMAGES/ACTION.DNP/PROJ3/obj/main.obj" \
		--host-exists "IMAGES/ACTION.DNP/PROJ3/bin/main.prg" \
		--host-exists "IMAGES/ACTION.DNP/PROJ3/bin/main.dbg" \
		--contains "ACTDBG MAIN" --contains "ACTEDIT src/main.act" --contains "B:DNP/PROJ3>"

