all: resident

clean:
	rm -rf $(BUILD_DIR)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

force:

$(AUTOEXEC_INC): $(AUTOEXEC_SRC) | $(BUILD_DIR)
	$(PYTHON) tools/make_autoexec_include.py --input $< --output $@

$(RESIDENT_OBJ): force $(ASM_DIR)/udos_resident.asm $(AUTOEXEC_INC) | $(BUILD_DIR)
	$(CA65) -g $(RESIDENT_DEFINES) -o $@ $(ASM_DIR)/udos_resident.asm -I $(BUILD_DIR) -I $(ASM_DIR)

$(RESIDENT_BOOT_OBJ): force $(ASM_DIR)/udos_boot.asm | $(BUILD_DIR)
	$(CA65) -g -o $@ $(ASM_DIR)/udos_boot.asm

$(RETURN_TEST_OBJ): force $(ASM_DIR)/udos_return_test.asm | $(BUILD_DIR)
	$(CA65) -g -o $@ $(ASM_DIR)/udos_return_test.asm

$(RETURN_TEST_BIN): $(RETURN_TEST_OBJ)
	$(LD65) -C $(ASM_DIR)/udos_prog.cfg -o $@ $(RETURN_TEST_OBJ)

$(RETURN_TEST_PRG): $(RETURN_TEST_BIN)
	$(PYTHON) -c "from pathlib import Path; data=Path('$(RETURN_TEST_BIN)').read_bytes(); Path('$(RETURN_TEST_PRG)').write_bytes(bytes((0x00,0x09))+data)"

$(CHAIN_TEST_OBJ): force $(ASM_DIR)/udos_chain_test.asm | $(BUILD_DIR)
	$(CA65) -g -o $@ $(ASM_DIR)/udos_chain_test.asm

$(CHAIN_TEST_BIN): $(CHAIN_TEST_OBJ)
	$(LD65) -C $(ASM_DIR)/udos_prog.cfg -o $@ $(CHAIN_TEST_OBJ)

$(CHAIN_TEST_PRG): $(CHAIN_TEST_BIN)
	$(PYTHON) -c "from pathlib import Path; data=Path('$(CHAIN_TEST_BIN)').read_bytes(); Path('$(CHAIN_TEST_PRG)').write_bytes(bytes((0x00,0x09))+data)"

$(CLOBBER_TEST_OBJ): force $(ASM_DIR)/udos_clobber_test.asm | $(BUILD_DIR)
	$(CA65) -g -o $@ $(ASM_DIR)/udos_clobber_test.asm

$(CLOBBER_TEST_BIN): $(CLOBBER_TEST_OBJ)
	$(LD65) -C $(ASM_DIR)/udos_prog.cfg -o $@ $(CLOBBER_TEST_OBJ)

$(CLOBBER_TEST_PRG): $(CLOBBER_TEST_BIN)
	$(PYTHON) -c "from pathlib import Path; data=Path('$(CLOBBER_TEST_BIN)').read_bytes(); Path('$(CLOBBER_TEST_PRG)').write_bytes(bytes((0x00,0x09))+data)"

$(TOOL_SWAP_TEST_OBJ): force $(ASM_DIR)/udos_tool_swap_test.asm | $(BUILD_DIR)
	$(CA65) -g -o $@ $(ASM_DIR)/udos_tool_swap_test.asm

$(TOOL_SWAP_TEST_BIN): $(TOOL_SWAP_TEST_OBJ)
	$(LD65) -C $(ASM_DIR)/udos_tool_swap_test.cfg -o $@ $(TOOL_SWAP_TEST_OBJ)

$(TOOL_SWAP_TEST_PRG): $(TOOL_SWAP_TEST_BIN)
	$(PYTHON) -c "from pathlib import Path; data=Path('$(TOOL_SWAP_TEST_BIN)').read_bytes(); Path('$(TOOL_SWAP_TEST_PRG)').write_bytes(bytes((0x00,0x09))+data)"

$(REU_SERVICE_TEST_OBJ): force $(ASM_DIR)/udos_reu_service_test.asm | $(BUILD_DIR)
	$(CA65) -g -o $@ $(ASM_DIR)/udos_reu_service_test.asm

$(REU_SERVICE_TEST_BIN): $(REU_SERVICE_TEST_OBJ)
	$(LD65) -C $(ASM_DIR)/udos_prog.cfg -o $@ $(REU_SERVICE_TEST_OBJ)

$(REU_SERVICE_TEST_PRG): $(REU_SERVICE_TEST_BIN)
	$(PYTHON) -c "from pathlib import Path; data=Path('$(REU_SERVICE_TEST_BIN)').read_bytes(); Path('$(REU_SERVICE_TEST_PRG)').write_bytes(bytes((0x00,0x09))+data)"

resident: $(RESIDENT_OBJ) $(RESIDENT_BOOT_OBJ)
	$(LD65) -Ln $(RESIDENT_LABELS) -C $(ASM_DIR)/udos_c64.cfg -m $(RESIDENT_MAP) -o $(RESIDENT_PRG) $(RESIDENT_OBJ)
	cp $(RESIDENT_PRG) $(RESIDENT_RAW)
	$(LD65) -Ln $(RESIDENT_BOOT_LABELS) -C $(ASM_DIR)/udos_boot.cfg -m $(RESIDENT_BOOT_MAP) -o $(RESIDENT_BOOT_PRG) $(RESIDENT_BOOT_OBJ)
	$(PYTHON) -c "from pathlib import Path; data=Path('$(RESIDENT_BOOT_PRG)').read_bytes(); Path('$(RESIDENT_BOOT_LOAD_PRG)').write_bytes(bytes((0x10,0x08))+data)"
	$(PYTHON) tools/make_basic_autostart.py --input $(RESIDENT_BOOT_LOAD_PRG) --labels $(RESIDENT_BOOT_LABELS) --output $(RESIDENT_AUTO_PRG) --expected-load-addr 0x0810
	$(C1541) -format "udos,01" d64 $(RESIDENT_DISK) -write $(RESIDENT_AUTO_PRG) udosboot -write $(RESIDENT_RAW) udoscore

release:
	$(MAKE) BUILD_DIR=$(RELEASE_BUILD) RESIDENT_DEFINES="-D UDOS_INCLUDE_AUTOEXEC=0" resident
	bash $(ACTC_UDOS_BUILD)
	bash $(ACTC_OVERLAY_BUILD)
	bash $(ACTC_OVERLAY_SOURCE_BUILD)
	bash $(ACTC_OVERLAY_DECL_BUILD)
	bash $(ACTC_OVERLAY_LAYOUT_BUILD)
	bash $(ACTC_OVERLAY_IMPORT_BUILD)
	bash $(ACTC_OVERLAY_EMIT_BUILD)
	bash $(ACTC_OVERLAY_BODY_BUILD)
	bash $(ACTC_OVERLAY_PREALLOC_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_LOCAL_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_REAL_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_REAL_CONTROL_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_REAL_WHILE_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_RUNTIME_CONDITION_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_RUNTIME_SEQUENCE_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_RUNTIME_NESTED_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_LOCAL_RUNTIME_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_LOCAL_MIXED_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_REAL_POSTFIX_EMIT_BUILD)
	bash $(ACTC_OVERLAY_NATIVE_REAL_POSTFIX_CONTROL_EMIT_BUILD)
	bash $(ACTADD_UDOS_BUILD)
	bash $(ACT2SAVE_UDOS_BUILD)
	bash $(ALINK_UDOS_BUILD)
	bash $(ACTMON_UDOS_BUILD)
	bash $(ACTCHK_UDOS_BUILD)
	bash $(ACTCOPY_UDOS_BUILD)
	bash $(ACTDEL_UDOS_BUILD)
	bash $(ACTEDIT_UDOS_BUILD)
	bash $(ACTEDIT_OVERLAY_BUILD)
	bash $(ACTDIR_UDOS_BUILD)
	bash $(TREE_OVERLAY_BUILD)
	bash $(XCOPY_OVERLAY_BUILD)
	bash $(DELTREE_OVERLAY_BUILD)
	bash $(ACTFILE_UDOS_BUILD)
	bash $(ACTINFO_UDOS_BUILD)
	bash $(ACTMKDIR_UDOS_BUILD)
	bash $(ACTMOVE_UDOS_BUILD)
	bash $(ACTNEW_UDOS_BUILD)
	bash $(ACTRMDIR_UDOS_BUILD)
	bash $(ACTSRC_UDOS_BUILD)
	bash $(ACTWRITE_UDOS_BUILD)
	bash $(ACTWORK_UDOS_BUILD)
	$(PYTHON) tools/prepare_release_fs.py --base $(VICE_FS_ROOT) --output $(RELEASE_FS)
	# ACTION.DNP is the complete development set; the capacity-limited D64 is only the boot/tool subset.
	test -s $(RELEASE_FS)/IMAGES/ACTION.DNP/ACTDBG.PRG
	test -s $(RELEASE_FS)/IMAGES/ACTION.DNP/ACTDBG_OVL1.BIN
	test -s $(RELEASE_FS)/IMAGES/ACTION.DNP/ACTDBG_OVL2.BIN
	test -s $(RELEASE_FS)/IMAGES/ACTION.DNP/ACTEDIT.PRG
	test -s $(RELEASE_FS)/IMAGES/ACTION.DNP/ACTEDIT_OVL1.BIN
	$(PYTHON) -c "from pathlib import Path; root=Path('$(RELEASE_FS)/IMAGES/ACTION.DNP'); assert (root/'ACTDBG_OVL1.BIN').read_bytes()[:4] == b'DGOV'; assert (root/'ACTDBG_OVL2.BIN').read_bytes()[:4] == b'DGOV'; assert (root/'ACTEDIT_OVL1.BIN').read_bytes()[:5] == b'AEOV\x02'"
	cp $(RELEASE_BUILD)/udos-resident.d64 $(RELEASE_DISK)
	-$(C1541) $(RELEASE_DISK) -delete ACTC.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL0.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL1.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL2.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL3.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL4.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL5.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL6.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL7.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL8.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVL9.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVLA.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVLB.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVLC.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVLD.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVLE.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVLF.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVLG.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTC_OVLH.BIN
	-$(C1541) $(RELEASE_DISK) -delete ACTADD.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACT2SAVE.PRG
	-$(C1541) $(RELEASE_DISK) -delete ALINK.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTMON.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTCHK.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTCOPY.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTDEL.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTEDIT.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTDIR.PRG
	-$(C1541) $(RELEASE_DISK) -delete TREE.OVL
	-$(C1541) $(RELEASE_DISK) -delete XCOPY.OVL
	-$(C1541) $(RELEASE_DISK) -delete DELTREE.OVL
	-$(C1541) $(RELEASE_DISK) -delete ACTFILE.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTINFO.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTMKDIR.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTMOVE.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTNEW.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTRMDIR.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTSRC.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTWRITE.PRG
	-$(C1541) $(RELEASE_DISK) -delete ACTWORK.PRG
	# The complete compiler/toolchain lives on ACTION.DNP. Keep the 1541 image a valid boot plus standalone OBJ linker disk.
	$(C1541) $(RELEASE_DISK) -write $(ALINK_UDOS_PRG) ALINK.PRG

vice-release: $(RELEASE_DEPS)
	$(PYTHON) tools/vice_prg_probe.py --disk $(RELEASE_DISK) \
		--expected "A:D64/>" --settle 1.0 --absent "AUTOEXEC OK"

vice-action-workspace: $(RELEASE_DEPS)
	rm -rf $(ACTION_WORKSPACE_FS)
	mkdir -p $(ACTION_WORKSPACE_FS)
	cp -a $(RELEASE_FS)/. $(ACTION_WORKSPACE_FS)/
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(ACTION_WORKSPACE_FS) \
		--pre-command "DIR" --pre-prompt "B:DNP/>" --pre-fragment "BIN/ DOC/ LIB/ SRC/" \
		--command "TYPE README.TXT" --run-marker "" --done-fragment "ACTIONC64U FOR UDOS" --skip-command-prompt \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "ACTIONC64U FOR UDOS"

vice-action-actadd: $(RELEASE_DEPS)
	rm -rf $(ACTION_ACTADD_FS)
	mkdir -p $(ACTION_ACTADD_FS)
	cp -a $(RELEASE_FS)/. $(ACTION_ACTADD_FS)/
	rm -rf $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3 $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/proj3
	grep -qi '^D PROJ3$$' $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT || { printf 'D PROJ3\n' > $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/UDOSDIR.PROJ3; cat $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT >> $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/UDOSDIR.PROJ3; mv $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/UDOSDIR.PROJ3 $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT; }
	mkdir -p $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/src \
		$(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/bin \
		$(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/obj
	printf 'ACTION PROJECT READY\n' > $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/readme.txt
	printf 'ACTION PROJECT\rMAIN.ACT\r' > $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/ACTION.PROJ
	printf 'D BIN\nD OBJ\nD SRC\nF ACTION.PROJ\nF README.TXT\n' > $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/UDOSDIR.TXT
	printf 'F MAIN.ACT\n' > $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/src/UDOSDIR.TXT
	printf '' > $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/bin/UDOSDIR.TXT
	printf '' > $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/obj/UDOSDIR.TXT
	printf 'PROC MAIN()\rENDPROC\r' > $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/src/main.act
	ln -s PROJ3 $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/proj3
	ln -s ACTION.PROJ $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/action.proj
	ln -s UDOSDIR.TXT $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/udosdir.txt
	ln -s src $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/SRC
	ln -s bin $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/BIN
	ln -s obj $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/OBJ
	ln -s readme.txt $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/README.TXT
	ln -s UDOSDIR.TXT $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/src/udosdir.txt
	ln -s main.act $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/src/MAIN.ACT
	ln -s UDOSDIR.TXT $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/bin/udosdir.txt
	ln -s UDOSDIR.TXT $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/obj/udosdir.txt
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(ACTION_ACTADD_FS) \
		--pre-command "CD PROJ3" --pre-prompt "B:DNP/PROJ3>" \
		--command "ACTADD HELPER" --run-marker "RUN ACTADD.PRG" --done-fragment "ACTADD OK" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/PROJ3>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "RUN ACTADD.PRG" --contains "ACTADD OK" --contains "B:DNP/PROJ3>"
	test -d $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/bin
	test -d $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/obj
	test -d $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/src
	test -f $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/ACTION.PROJ
	grep -q "ACTION PROJECT" $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/ACTION.PROJ
	grep -q "MAIN.ACT" $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/ACTION.PROJ
	grep -q "HELPER.ACT" $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/ACTION.PROJ
	grep -q "D SRC" $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/UDOSDIR.TXT
	grep -q "F HELPER.ACT" $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/SRC/UDOSDIR.TXT
	grep -q "PROC HELPER()" $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/src/helper.act
	grep -q "ENDPROC" $(ACTION_ACTADD_FS)/IMAGES/ACTION.DNP/PROJ3/src/helper.act

vice-action-actdir: $(RELEASE_DEPS)
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(RELEASE_FS) \
		--command "ACTDIR SRC" --run-marker "RUN ACTDIR.PRG" --done-fragment "" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "RUN ACTDIR.PRG" --contains "HELLO.ACT"

vice-action-tree-overlay: $(RELEASE_DEPS)
	rm -rf $(ACTION_TREE_OVERLAY_FS)
	mkdir -p $(ACTION_TREE_OVERLAY_FS)
	cp -a $(RELEASE_FS)/. $(ACTION_TREE_OVERLAY_FS)/
	mkdir -p $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/NEST/DEEP
	printf 'D NEST\nF HELLO.ACT\nF TREE_TOP.ACT\n' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/UDOSDIR.TXT
	printf 'D DEEP\nF LEAF.ACT\n' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/NEST/UDOSDIR.TXT
	printf 'F FINAL.ACT\n' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/NEST/DEEP/UDOSDIR.TXT
	printf 'PROC TREE_TOP()\rENDPROC\r' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/TREE_TOP.ACT
	printf 'PROC LEAF()\rENDPROC\r' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/NEST/LEAF.ACT
	printf 'PROC FINAL()\rENDPROC\r' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/NEST/DEEP/FINAL.ACT
	$(PYTHON) -c "from pathlib import Path; from tools.prepare_release_fs import add_lowercase_aliases; add_lowercase_aliases(Path('$(ACTION_TREE_OVERLAY_FS)'))"
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(ACTION_TREE_OVERLAY_FS) \
		--command "TREE SRC" --run-marker "RUN TREE.OVL" --done-fragment "" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "RUN TREE.OVL" --contains "ARGS SRC" --contains "SRC/NEST/" \
		--contains "SRC/NEST/DEEP/" --contains "SRC/NEST/DEEP/FINAL.ACT"

vice-action-tree-overlay-invalid: $(RELEASE_DEPS)
	rm -rf $(ACTION_TREE_OVERLAY_FS)
	mkdir -p $(ACTION_TREE_OVERLAY_FS)
	cp -a $(RELEASE_FS)/. $(ACTION_TREE_OVERLAY_FS)/
	mkdir -p $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/NEST/DEEP
	printf 'D NEST\nF HELLO.ACT\nF TREE_TOP.ACT\n' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/UDOSDIR.TXT
	printf 'D DEEP\nF LEAF.ACT\n' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/NEST/UDOSDIR.TXT
	printf 'F FINAL.ACT\n' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/SRC/NEST/DEEP/UDOSDIR.TXT
	printf '\000\011BAD OVERLAY' > $(ACTION_TREE_OVERLAY_FS)/IMAGES/ACTION.DNP/TREE.OVL
	$(PYTHON) -c "from pathlib import Path; from tools.prepare_release_fs import add_lowercase_aliases; add_lowercase_aliases(Path('$(ACTION_TREE_OVERLAY_FS)'))"
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(ACTION_TREE_OVERLAY_FS) \
		--command "TREE SRC" --done-fragment "NEST/" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "SRC" --contains "NEST/" --contains "HELLO.ACT" \
		--not-contains "RUN TREE.OVL" --not-contains "DEEP/" --not-contains "FINAL.ACT"

vice-action-xcopy-overlay: $(RELEASE_DEPS)
	rm -rf $(ACTION_XCOPY_OVERLAY_FS)
	mkdir -p $(ACTION_XCOPY_OVERLAY_FS)
	cp -a $(RELEASE_FS)/. $(ACTION_XCOPY_OVERLAY_FS)/
	mkdir -p $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/DEEP
	printf 'D XCSRC\n' >> $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT
	printf 'D NEST\nF ROOT.TXT\nF R2.TXT\nF R3.TXT\nF R4.TXT\nF R5.TXT\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/UDOSDIR.TXT
	printf 'D DEEP\nF MID.TXT\nF N2.TXT\nF N3.TXT\nF N4.TXT\nF N5.TXT\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/UDOSDIR.TXT
	printf 'F LEAF.TXT\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/DEEP/UDOSDIR.TXT
	printf 'XCOPY ROOT\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/ROOT.TXT
	printf 'XCOPY ROOT 2\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/R2.TXT
	printf 'XCOPY ROOT 3\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/R3.TXT
	printf 'XCOPY ROOT 4\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/R4.TXT
	printf 'XCOPY ROOT 5\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/R5.TXT
	printf 'XCOPY MIDDLE\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/MID.TXT
	printf 'XCOPY NEST 2\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/N2.TXT
	printf 'XCOPY NEST 3\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/N3.TXT
	printf 'XCOPY NEST 4\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/N4.TXT
	printf 'XCOPY NEST 5\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/N5.TXT
	printf 'XCOPY LEAF\n' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/DEEP/LEAF.TXT
	$(PYTHON) -c "from pathlib import Path; from tools.prepare_release_fs import add_lowercase_aliases; add_lowercase_aliases(Path('$(ACTION_XCOPY_OVERLAY_FS)'))"
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(ACTION_XCOPY_OVERLAY_FS) \
		--command "XCOPY XCSRC XCDST" --run-marker "RUN XCOPY.OVL" --done-fragment "XCOPY OK" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "RUN XCOPY.OVL" --contains "ARGS XCSRC XCDST" --contains "XCOPY OK"
	cmp $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/ROOT.TXT $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/root.txt
	cmp $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/R5.TXT $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/r5.txt
	cmp $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/MID.TXT $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/nest/mid.txt
	cmp $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/N5.TXT $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/nest/n5.txt
	cmp $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCSRC/NEST/DEEP/LEAF.TXT $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/nest/deep/leaf.txt
	grep -qi '^D XCDST$$' $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT
	grep -qi '^D NEST$$' $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/UDOSDIR.TXT
	grep -qi '^D DEEP$$' $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/nest/UDOSDIR.TXT
	grep -qi '^F N5.TXT$$' $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/nest/UDOSDIR.TXT
	grep -qi '^F LEAF.TXT$$' $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst/nest/deep/UDOSDIR.TXT
	test -z "$$(find $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/xcdst -name 'UDOSDIR.TMP' -print -quit)"

vice-action-xcopy-overlay-invalid: $(RELEASE_DEPS)
	rm -rf $(ACTION_XCOPY_OVERLAY_FS)
	mkdir -p $(ACTION_XCOPY_OVERLAY_FS)
	cp -a $(RELEASE_FS)/. $(ACTION_XCOPY_OVERLAY_FS)/
	printf '\000\011BAD OVERLAY' > $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCOPY.OVL
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(ACTION_XCOPY_OVERLAY_FS) \
		--command "XCOPY XCSRC XCDST" --done-fragment "OVERLAY INVALID" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "OVERLAY INVALID" --not-contains "RUN XCOPY.OVL" --not-contains "XCOPY OK"
	test ! -e $(ACTION_XCOPY_OVERLAY_FS)/IMAGES/ACTION.DNP/XCDST

vice-action-xcopy-overlay-flat: $(RELEASE_DEPS)
	$(PYTHON) tools/vice_prg_probe.py --disk $(RELEASE_DISK) \
		--feed-after "A:D64/>" --feed-text "XCOPY SRC XCDST\r" \
		--expected "FLAT IMAGE" --contains "FLAT IMAGE" --settle 1.0

vice-action-deltree-overlay: $(RELEASE_DEPS)
	rm -rf $(ACTION_DELTREE_OVERLAY_FS)
	mkdir -p $(ACTION_DELTREE_OVERLAY_FS)
	cp -a $(RELEASE_FS)/. $(ACTION_DELTREE_OVERLAY_FS)/
	mkdir -p $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/deep
	printf 'D DTBASE\n' >> $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT
	printf 'D DTSRC\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/UDOSDIR.TXT
	printf 'D NEST\nF ROOT.TXT\nF R2.TXT\nF R3.TXT\nF R4.TXT\nF R5.TXT\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/UDOSDIR.TXT
	printf 'D DEEP\nF MID.TXT\nF N2.TXT\nF N3.TXT\nF N4.TXT\nF N5.TXT\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/UDOSDIR.TXT
	printf 'F LEAF.TXT\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/deep/UDOSDIR.TXT
	printf 'DELTREE ROOT\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/root.txt
	printf 'DELTREE ROOT 2\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/r2.txt
	printf 'DELTREE ROOT 3\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/r3.txt
	printf 'DELTREE ROOT 4\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/r4.txt
	printf 'DELTREE ROOT 5\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/r5.txt
	printf 'DELTREE MIDDLE\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/mid.txt
	printf 'DELTREE NEST 2\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/n2.txt
	printf 'DELTREE NEST 3\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/n3.txt
	printf 'DELTREE NEST 4\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/n4.txt
	printf 'DELTREE NEST 5\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/n5.txt
	printf 'DELTREE LEAF\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc/nest/deep/leaf.txt
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(ACTION_DELTREE_OVERLAY_FS) \
		--command "DELTREE DTBASE/DTSRC" --run-marker "RUN DELTREE.OVL" --done-fragment "DELTREE OK" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "RUN DELTREE.OVL" --contains "ARGS DTBASE/DTSRC" --contains "DELTREE OK"
	test ! -e $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/dtsrc
	! grep -qi '^D DTSRC$$' $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtbase/UDOSDIR.TXT

vice-action-deltree-overlay-large-manifest: $(RELEASE_DEPS)
	rm -rf $(ACTION_DELTREE_OVERLAY_FS)
	mkdir -p $(ACTION_DELTREE_OVERLAY_FS)
	cp -a $(RELEASE_FS)/. $(ACTION_DELTREE_OVERLAY_FS)/
	mkdir -p $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtroot/nest
	printf 'D DTROOT' >> $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT
	printf 'D NEST\nF ROOT.TXT\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtroot/UDOSDIR.TXT
	printf 'F LEAF.TXT\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtroot/nest/UDOSDIR.TXT
	printf 'ROOT\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtroot/root.txt
	printf 'LEAF\n' > $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtroot/nest/leaf.txt
	cp $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT $(ACTION_DELTREE_OVERLAY_FS)/root-manifest.before
	test $$(wc -c < $(ACTION_DELTREE_OVERLAY_FS)/root-manifest.before) -gt 255
	sleep 2
	$(PYTHON) tools/run_action_command_probe.py --disk $(RELEASE_DISK) --fs-root $(ACTION_DELTREE_OVERLAY_FS) \
		--pre-command "MD BIGTMP" --pre-prompt "B:DNP/>" --pre-fragment "CREATED" \
		--pre-command "COPY MAIN.ACT BIGTMP/FIRST.ACT" --pre-prompt "B:DNP/>" --pre-fragment "COPIED" \
		--pre-command "DEL BIGTMP/FIRST.ACT" --pre-prompt "B:DNP/>" --pre-fragment "DELETED" \
		--pre-command "RD BIGTMP" --pre-prompt "B:DNP/>" --pre-fragment "REMOVED" \
		--pre-command "COPY MAIN.ACT BIG1.ACT" --pre-prompt "B:DNP/>" --pre-fragment "COPIED" \
		--pre-command "REN BIG1.ACT BIG2.ACT" --pre-prompt "B:DNP/>" --pre-fragment "RENAMED" \
		--pre-command "DEL BIG2.ACT" --pre-prompt "B:DNP/>" --pre-fragment "DELETED" \
		--command "DELTREE DTROOT" --run-marker "RUN DELTREE.OVL" --done-fragment "DELTREE OK" \
		--b-prompt "B:DNP/>" --final-prompt "B:DNP/>" \
		--attempts 4 --attempt-delay 2.0 \
		--contains "CREATED" --contains "REMOVED" --contains "COPIED" --contains "RENAMED" --contains "DELETED" \
		--contains "RUN DELTREE.OVL" --contains "ARGS DTROOT" --contains "DELTREE OK"
	test ! -e $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/dtroot
	test ! -e $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/bigtmp
	test ! -e $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/big1.act
	test ! -e $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/big2.act
	grep -iv '^D DTROOT$$' $(ACTION_DELTREE_OVERLAY_FS)/root-manifest.before > $(ACTION_DELTREE_OVERLAY_FS)/root-manifest.expected
	cmp $(ACTION_DELTREE_OVERLAY_FS)/root-manifest.expected $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP/UDOSDIR.TXT
	test -z "$$(find $(ACTION_DELTREE_OVERLAY_FS)/IMAGES/ACTION.DNP -name 'UDOSDIR.TMP' -print -quit)"

